{
  "name": "metro-empire",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "balance": "vite-node scripts/balance.ts"
  },
  "dependencies": {
    "d3-delaunay": "^6.0.4",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@types/d3-delaunay": "^6.0.4",
    "typescript": "~5.9",
    "vite": "^8.3.2",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0"
  }
}
